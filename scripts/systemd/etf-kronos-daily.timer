[Unit]
Description=Update the tracked stock's daily forecast after the Shenzhen close

[Timer]
OnCalendar=Mon..Fri *-*-* 15:20:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 15:50:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 17:00:00 Asia/Shanghai
AccuracySec=10s
Persistent=true
Unit=etf-kronos@daily.service

[Install]
WantedBy=timers.target
